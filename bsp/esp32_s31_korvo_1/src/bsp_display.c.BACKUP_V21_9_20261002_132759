esp_err_t bsp_display_new(const bsp_display_config_t *config, esp_lcd_panel_handle_t *ret_panel,
                          esp_lcd_panel_io_handle_t *ret_io)
{
    esp_err_t ret = ESP_OK;
    bsp_lcd_handles_t handles;
    ret = bsp_display_new_with_handles(config, &handles);

    *ret_panel = handles.panel;
    *ret_io = handles.io;

    return ret;
}

esp_err_t bsp_display_new_with_handles(const bsp_display_config_t *config, bsp_lcd_handles_t *ret_handles)
{
    esp_err_t ret = ESP_OK;

    /* DISPLAY - RGB */
    ESP_LOGI(TAG, "Initialize RGB panel");
    esp_lcd_rgb_panel_config_t panel_conf = {
        .clk_src = LCD_CLK_SRC_PLL160M,
        .dma_burst_size = 64,
        .data_width = 16,
        .in_color_format = LCD_COLOR_FMT_RGB565,
        .de_gpio_num = BSP_LCD_RGB_DE,
        .pclk_gpio_num = BSP_LCD_RGB_PCLK,
        .vsync_gpio_num = BSP_LCD_RGB_VSYNC,
        .hsync_gpio_num = BSP_LCD_RGB_HSYNC,
        .disp_gpio_num = BSP_LCD_RGB_DISP,
        .data_gpio_nums = {
            BSP_LCD_RGB_DATA0,
            BSP_LCD_RGB_DATA1,
            BSP_LCD_RGB_DATA2,
            BSP_LCD_RGB_DATA3,
            BSP_LCD_RGB_DATA4,
            BSP_LCD_RGB_DATA5,
            BSP_LCD_RGB_DATA6,
            BSP_LCD_RGB_DATA7,
            BSP_LCD_RGB_DATA8,
            BSP_LCD_RGB_DATA9,
            BSP_LCD_RGB_DATA10,
            BSP_LCD_RGB_DATA11,
            BSP_LCD_RGB_DATA12,
            BSP_LCD_RGB_DATA13,
            BSP_LCD_RGB_DATA14,
            BSP_LCD_RGB_DATA15,
        },
        .timings = BSP_DISPLAY_PANEL_RGB_TIMING(),
        .flags.fb_in_psram = 1,
        .num_fbs = CONFIG_BSP_LCD_RGB_BUFFER_NUMS,
#if CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_MODE
        .bounce_buffer_size_px = BSP_LCD_H_RES * CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_HEIGHT,
#endif
    };
    ESP_GOTO_ON_ERROR(esp_lcd_new_rgb_panel(&panel_conf, &ret_handles->panel), err, TAG, "RGB init failed");

    disp_handles.panel = ret_handles->panel;

    esp_lcd_panel_reset(ret_handles->panel);
    esp_lcd_panel_init(ret_handles->panel);
    /* KORVO_V20: RGB event callback is owned by esp_lvgl_port. */
    esp_lcd_panel_invert_color(ret_handles->panel, false);
    esp_lcd_panel_swap_xy(ret_handles->panel, false);
    esp_lcd_panel_mirror(ret_handles->panel, false, false);

    ESP_LOGI(TAG, "Display initialized with resolution %dx%d", BSP_LCD_H_RES, BSP_LCD_V_RES);
    return ret;

err:
    bsp_display_delete();
    return ret;
}

/* KORVO_V21_4_MANUAL_DISPLAY_RESYNC
 * Diagnostic recovery experiment.
 * Re-run the RGB panel reset/init sequence on the EXISTING panel handle.
 * Do not delete/recreate LVGL, touch, camera, network, SIP or Bluetooth.
 */
esp_err_t bsp_display_manual_resync(void)
{
    static bool busy = false;
    if (busy) {
        return ESP_ERR_INVALID_STATE;
    }
    if (disp_handles.panel == NULL) {
        return ESP_ERR_INVALID_STATE;
    }

    busy = true;
    ESP_LOGW(TAG, "DISPLAY RESYNC: RGB panel reset/init requested");

    esp_err_t err = esp_lcd_panel_reset(disp_handles.panel);
    if (err == ESP_OK) {
        err = esp_lcd_panel_init(disp_handles.panel);
    }
    if (err == ESP_OK) {
        err = esp_lcd_panel_disp_on_off(disp_handles.panel, true);
    }

    if (err == ESP_OK) {
        ESP_LOGW(TAG, "DISPLAY RESYNC: OK");
    } else {
        ESP_LOGE(TAG, "DISPLAY RESYNC: FAILED: %s", esp_err_to_name(err));
    }

    busy = false;
    return err;
}

/* KORVO_V21_6_LCD_FORENSICS
 * Save the RGB driver's REAL framebuffer(s), not an LVGL redraw.
 * This lets us compare what memory contains against what the physical LCD shows.
 * SD destination deliberately stays inside the approved KORVO tree:
 *     /sdcard/korvo/temp/lcd_debug/
 */
#define KORVO_LCD_CAPTURE_DIR "/sdcard/korvo/temp/lcd_debug"

static void korvo_bmp_put_u16(FILE *f, uint16_t v)
{
    uint8_t b[2] = {(uint8_t)(v & 0xff), (uint8_t)((v >> 8) & 0xff)};
    fwrite(b, 1, sizeof(b), f);
}

static void korvo_bmp_put_u32(FILE *f, uint32_t v)
{
    uint8_t b[4] = {
        (uint8_t)(v & 0xff), (uint8_t)((v >> 8) & 0xff),
        (uint8_t)((v >> 16) & 0xff), (uint8_t)((v >> 24) & 0xff)
    };
    fwrite(b, 1, sizeof(b), f);
}

static esp_err_t korvo_save_rgb565_bmp(const char *path, const uint16_t *fb)
{
    if (!path || !fb) return ESP_ERR_INVALID_ARG;

    FILE *f = fopen(path, "wb");
    if (!f) {
        ESP_LOGE(TAG, "LCD CAPTURE: fopen failed %s errno=%d", path, errno);
        return ESP_FAIL;
    }

    const uint32_t w = BSP_LCD_H_RES;
    const uint32_t h = BSP_LCD_V_RES;
    const uint32_t row_bytes = (w * 3U + 3U) & ~3U;
    const uint32_t pixel_bytes = row_bytes * h;
    const uint32_t file_bytes = 54U + pixel_bytes;

    /* BITMAPFILEHEADER */
    fwrite("BM", 1, 2, f);
    korvo_bmp_put_u32(f, file_bytes);
    korvo_bmp_put_u16(f, 0);
    korvo_bmp_put_u16(f, 0);
    korvo_bmp_put_u32(f, 54);

    /* BITMAPINFOHEADER: 24-bit BGR, uncompressed */
    korvo_bmp_put_u32(f, 40);
    korvo_bmp_put_u32(f, w);
    korvo_bmp_put_u32(f, h);
    korvo_bmp_put_u16(f, 1);
    korvo_bmp_put_u16(f, 24);
    korvo_bmp_put_u32(f, 0);
    korvo_bmp_put_u32(f, pixel_bytes);
    korvo_bmp_put_u32(f, 2835);
    korvo_bmp_put_u32(f, 2835);
    korvo_bmp_put_u32(f, 0);
    korvo_bmp_put_u32(f, 0);

    uint8_t row[BSP_LCD_H_RES * 3 + 4];
    for (int y = BSP_LCD_V_RES - 1; y >= 0; --y) {
        uint8_t *p = row;
        const uint16_t *src = fb + ((size_t)y * BSP_LCD_H_RES);
        for (int x = 0; x < BSP_LCD_H_RES; ++x) {
            uint16_t c = src[x];
            uint8_t r5 = (uint8_t)((c >> 11) & 0x1f);
            uint8_t g6 = (uint8_t)((c >> 5) & 0x3f);
            uint8_t b5 = (uint8_t)(c & 0x1f);
            *p++ = (uint8_t)((b5 << 3) | (b5 >> 2));
            *p++ = (uint8_t)((g6 << 2) | (g6 >> 4));
            *p++ = (uint8_t)((r5 << 3) | (r5 >> 2));
        }
        while ((size_t)(p - row) < row_bytes) *p++ = 0;
        if (fwrite(row, 1, row_bytes, f) != row_bytes) {
            fclose(f);
            ESP_LOGE(TAG, "LCD CAPTURE: write failed %s", path);
            return ESP_FAIL;
        }
    }

    fflush(f);
    fclose(f);
    return ESP_OK;
}


/* KORVO_V21_7_RAW_LCD_SNAPSHOT
 * Fast forensic snapshot:
 *  1) memcpy the REAL RGB565 framebuffer into a PSRAM snapshot
 *  2) release the live framebuffer immediately
 *  3) write the frozen bytes to SD as RAW
 *
 * No RGB565->RGB888 conversion. No BMP generation on the KORVO.
 */
#define KORVO_LCD_CAPTURE_DIR "/sdcard/korvo/temp/lcd_debug"
#define KORVO_LCD_RAW_BYTES ((size_t)BSP_LCD_H_RES * (size_t)BSP_LCD_V_RES * 2U)

static esp_err_t korvo_write_raw_snapshot(const char *path, const void *src, size_t bytes)
{
    FILE *f = fopen(path, "wb");
    if (!f) {
        ESP_LOGE(TAG, "LCD RAW: fopen failed path=%s errno=%d", path, errno);
        return ESP_FAIL;
    }

    const uint8_t *p = (const uint8_t *)src;
    size_t total = 0;
    while (total < bytes) {
        size_t chunk = bytes - total;
        if (chunk > 32768U) chunk = 32768U;

        size_t n = fwrite(p + total, 1, chunk, f);
        total += n;

        if (n != chunk) {
            ESP_LOGE(TAG,
                     "LCD RAW: WRITE FAIL expected=%u written=%u last=%u errno=%d ferror=%d",
                     (unsigned)bytes, (unsigned)total, (unsigned)n, errno, ferror(f));
            fclose(f);
            return ESP_FAIL;
        }
    }

    if (fflush(f) != 0) {
        ESP_LOGE(TAG, "LCD RAW: fflush failed errno=%d", errno);
        fclose(f);
        return ESP_FAIL;
    }

    long final_pos = ftell(f);
    if (fclose(f) != 0) {
        ESP_LOGE(TAG, "LCD RAW: fclose failed errno=%d", errno);
        return ESP_FAIL;
    }

    if (final_pos != (long)bytes) {
        ESP_LOGE(TAG, "LCD RAW: SIZE FAIL expected=%u ftell=%ld",
                 (unsigned)bytes, final_pos);
        return ESP_FAIL;
    }

    ESP_LOGW(TAG, "LCD RAW: WRITE OK bytes=%u", (unsigned)bytes);
    return ESP_OK;
}

esp_err_t bsp_display_capture_framebuffers_raw(uint32_t capture_id)
{
    if (!disp_handles.panel) return ESP_ERR_INVALID_STATE;

    if (mkdir(KORVO_LCD_CAPTURE_DIR, 0775) != 0 && errno != EEXIST) {
        ESP_LOGE(TAG, "LCD RAW: mkdir failed %s errno=%d",
                 KORVO_LCD_CAPTURE_DIR, errno);
        return ESP_FAIL;
    }

    void *fb0 = NULL;
#if CONFIG_BSP_LCD_RGB_BUFFER_NUMS >= 2
    void *fb1 = NULL;
    esp_err_t err = esp_lcd_rgb_panel_get_frame_buffer(disp_handles.panel, 2, &fb0, &fb1);
#else
    esp_err_t err = esp_lcd_rgb_panel_get_frame_buffer(disp_handles.panel, 1, &fb0);
#endif
    if (err != ESP_OK || !fb0) {
        ESP_LOGE(TAG, "LCD RAW: get framebuffer failed: %s",
                 esp_err_to_name(err));
        return (err == ESP_OK) ? ESP_FAIL : err;
    }

    void *snap = heap_caps_malloc(KORVO_LCD_RAW_BYTES, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
    if (!snap) {
        ESP_LOGE(TAG, "LCD RAW: cannot allocate %u-byte PSRAM snapshot",
                 (unsigned)KORVO_LCD_RAW_BYTES);
        return ESP_ERR_NO_MEM;
    }

    char path[128];

    /* Freeze FB0 quickly, then write the frozen copy. */
    memcpy(snap, fb0, KORVO_LCD_RAW_BYTES);
    snprintf(path, sizeof(path), KORVO_LCD_CAPTURE_DIR "/LCD_%05lu_FB0.rgb565",
             (unsigned long)capture_id);
    ESP_LOGW(TAG, "LCD RAW #%lu FB0 snapshot -> %s expected=%u",
             (unsigned long)capture_id, path, (unsigned)KORVO_LCD_RAW_BYTES);
    err = korvo_write_raw_snapshot(path, snap, KORVO_LCD_RAW_BYTES);
    if (err != ESP_OK) {
        heap_caps_free(snap);
        return err;
    }

#if CONFIG_BSP_LCD_RGB_BUFFER_NUMS >= 2
    if (fb1) {
        memcpy(snap, fb1, KORVO_LCD_RAW_BYTES);
        snprintf(path, sizeof(path), KORVO_LCD_CAPTURE_DIR "/LCD_%05lu_FB1.rgb565",
                 (unsigned long)capture_id);
        ESP_LOGW(TAG, "LCD RAW #%lu FB1 snapshot -> %s expected=%u",
                 (unsigned long)capture_id, path, (unsigned)KORVO_LCD_RAW_BYTES);
        err = korvo_write_raw_snapshot(path, snap, KORVO_LCD_RAW_BYTES);
        if (err != ESP_OK) {
            heap_caps_free(snap);
            return err;
        }
    }
#endif

    heap_caps_free(snap);
    return ESP_OK;
}
void bsp_display_delete(void)
{
    if (disp_handles.panel) {
        esp_lcd_panel_del(disp_handles.panel);
        disp_handles.panel = NULL;
    }
    if (disp_handles.io) {
        esp_lcd_panel_io_del(disp_handles.io);
        disp_handles.io = NULL;
    }

    bsp_display_brightness_deinit();
}

#if (BSP_CONFIG_NO_GRAPHIC_LIB == 0)
static lv_display_t *bsp_display_lcd_init(const bsp_display_cfg_t *cfg)
{
    assert(cfg != NULL);
    esp_lcd_panel_io_handle_t io_handle = NULL;
    const bsp_display_config_t bsp_disp_cfg = {
        .dummy = 0,
    };
    BSP_ERROR_CHECK_RETURN_NULL(bsp_display_new(&bsp_disp_cfg, &disp_handles.panel, &io_handle));

    esp_lcd_panel_disp_on_off(disp_handles.panel, true);

    /* Add LCD screen */
    ESP_LOGD(TAG, "Add LCD screen");
    const lvgl_port_display_cfg_t disp_cfg = {
        .io_handle = io_handle,
        .panel_handle = disp_handles.panel,
        .buffer_size = cfg->buffer_size,
        .double_buffer = cfg->double_buffer,
        .hres = BSP_LCD_H_RES,
        .vres = BSP_LCD_V_RES,
        .monochrome = false,
        /* Rotation values must be same as used in esp_lcd for initial settings of the screen */
        .rotation = {
            .swap_xy = false,
            .mirror_x = false,
            .mirror_y = false,
        },
        .flags = {
            .buff_dma = cfg->flags.buff_dma,
            .buff_spiram = cfg->flags.buff_spiram,
#if LVGL_VERSION_MAJOR >= 9
            .swap_bytes = (BSP_LCD_BIGENDIAN ? true : false),
#endif
#if CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR
            .sw_rotate = false,                /* Avoid tearing is not supported for SW rotation */
#else
            .sw_rotate = cfg->flags.sw_rotate,
#endif
#if CONFIG_BSP_DISPLAY_LVGL_FULL_REFRESH
            .full_refresh = true,
#elif CONFIG_BSP_DISPLAY_LVGL_DIRECT_MODE
            .direct_mode = true,
#endif
        }
    };
    const lvgl_port_display_rgb_cfg_t rgb_cfg = {
        .flags = {
#if CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_MODE
            .bb_mode = 1,
#else
            .bb_mode = 0,
#endif
#if CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR
            .avoid_tearing = true,
#else
            .avoid_tearing = false,
#endif
        }
    };

    return lvgl_port_add_disp_rgb(&disp_cfg, &rgb_cfg);
}
#endif // (BSP_CONFIG_NO_GRAPHIC_LIB == 0)

esp_err_t bsp_touch_new(const bsp_touch_config_t *config, esp_lcd_touch_handle_t *ret_touch)
{
    /* Initilize I2C */
    BSP_ERROR_CHECK_RETURN_ERR(bsp_i2c_init());

    /* Initialize touch */
    esp_lcd_touch_config_t tp_cfg = {
        .x_max = BSP_LCD_H_RES,
        .y_max = BSP_LCD_V_RES,
        .rst_gpio_num = GPIO_NUM_NC, // Usually shared with LCD reset
        .int_gpio_num = BSP_LCD_TOUCH_INT,
        .levels = {
            .reset = 0,
            .interrupt = 0,
        },
        .flags = {
            .swap_xy = false,
            .mirror_x = false,
            .mirror_y = false,
        },
    };
    esp_lcd_panel_io_handle_t tp_io_handle = NULL;
    const esp_lcd_panel_io_i2c_config_t tp_io_config = ESP_LCD_TOUCH_IO_I2C_GT1151_CONFIG();
    ESP_RETURN_ON_ERROR(esp_lcd_new_panel_io_i2c(bsp_i2c_get_handle(), &tp_io_config, &tp_io_handle), TAG, "");

    ESP_RETURN_ON_ERROR(esp_lcd_touch_new_i2c_gt1151(tp_io_handle, &tp_cfg, ret_touch),
                        TAG, "New touch driver initialization failed");

    return ESP_OK;
}

