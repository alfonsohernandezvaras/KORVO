#include "korvo_embedded_audio.h"
#include "bsp/esp-bsp.h"
#include "esp_codec_dev.h"
#include "esp_log.h"
#include "nvs.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include <math.h>
#include <string.h>

static const char *TAG = "korvo_embedded";
static uint8_t s_vol = 50, s_mic = 50;
static bool s_loaded = false;
static esp_codec_dev_handle_t s_spk = NULL, s_input = NULL;
static TaskHandle_t s_beep_task = NULL;
static portMUX_TYPE s_mux = portMUX_INITIALIZER_UNLOCKED;

static void load(void) {
    if (s_loaded) return;
    portENTER_CRITICAL(&s_mux);
    if (!s_loaded) {
        nvs_handle_t n;
        if (nvs_open("korvo_embed", NVS_READONLY, &n) == ESP_OK) {
            uint8_t v;
            if (nvs_get_u8(n, "volume", &v) == ESP_OK && v <= 100) s_vol = v;
            if (nvs_get_u8(n, "mic", &v) == ESP_OK && v <= 100) s_mic = v;
            nvs_close(n);
        }
        s_loaded = true;
    }
    portEXIT_CRITICAL(&s_mux);
}
static esp_err_t save(const char *key, uint8_t value) {
    nvs_handle_t n;
    esp_err_t e = nvs_open("korvo_embed", NVS_READWRITE, &n);
    if (e != ESP_OK) return e;
    e = nvs_set_u8(n, key, value);
    if (e == ESP_OK) e = nvs_commit(n);
    nvs_close(n);
    return e;
}
uint8_t korvo_embedded_get_volume(void) { load(); return s_vol; }
uint8_t korvo_embedded_get_mic(void) { load(); return s_mic; }
esp_err_t korvo_embedded_set_volume(uint8_t v, bool persist) {
    if (v > 100) return ESP_ERR_INVALID_ARG;
    load(); s_vol = v;
    if (s_spk) (void)esp_codec_dev_set_out_vol(s_spk, v);
    return persist ? save("volume", v) : ESP_OK;
}
esp_err_t korvo_embedded_set_mic(uint8_t v, bool persist) {
    if (v > 100) return ESP_ERR_INVALID_ARG;
    load(); s_mic = v;
    if (s_input) (void)esp_codec_dev_set_in_gain(s_input, (float)v * 0.6f);
    return persist ? save("mic", v) : ESP_OK;
}
static void beep_task(void *arg) {
    (void)arg;
    if (!s_spk) {
        s_spk = bsp_audio_codec_speaker_init();
        if (!s_spk) { ESP_LOGE(TAG, "speaker init failed"); goto done; }
    }
    (void)esp_codec_dev_set_out_vol(s_spk, s_vol);
    esp_codec_dev_sample_info_t fs = {.sample_rate=22050, .channel=2, .bits_per_sample=16};
    esp_err_t e = esp_codec_dev_open(s_spk, &fs);
    if (e != ESP_OK) { ESP_LOGE(TAG, "speaker open: %s", esp_err_to_name(e)); goto done; }
    /* 160ms, stereo PCM, 880 Hz, soft fade-in/out, max 20% amplitude */
    int16_t pcm[256 * 2];
    const int count = 3528;
    for (int offset=0; offset<count; offset+=256) {
        int frames = (count-offset < 256) ? count-offset : 256;
        for (int i=0; i<frames; ++i) {
            int t=offset+i;
            float env = (t < 200 ? t/200.0f : (t > count-200 ? (count-t)/200.0f : 1.0f));
            int16_t v=(int16_t)(6500.0f*env*sinf(6.2831853f*880.0f*t/22050.0f));
            pcm[i*2]=v; pcm[i*2+1]=v;
        }
        e=esp_codec_dev_write(s_spk, pcm, frames*4);
        if(e!=ESP_OK) {ESP_LOGW(TAG, "speaker write: %s", esp_err_to_name(e)); break;}
    }
    (void)esp_codec_dev_close(s_spk);
done:
    s_beep_task=NULL;
    vTaskDelete(NULL);
}
void korvo_embedded_beep(void) {
    load();
    if (s_beep_task) return;
    if (xTaskCreate(beep_task, "korvo_beep", 4096, NULL, 4, &s_beep_task) != pdPASS)
        ESP_LOGE(TAG, "cannot create beep task");
}
