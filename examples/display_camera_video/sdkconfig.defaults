# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32p4"
CONFIG_BSP_SELECT_ESP32_P4_EYE=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n


# SPIRAM for ESP32-P4
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

# Camera config
CONFIG_FREERTOS_HZ=1000
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_CAMERA_OV2710=y
CONFIG_CAM_CTRL_SPI_ENABLE=n


## LVGL9 ##
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_BUILD_EXAMPLES=n

# CLIB default
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y

# Performance monitor
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
# LVGL 9.6 / ESP-IDF 6.1 compatibility: keep legacy LV_ASSERT_HANDLER_INCLUDE without -Werror failure
CONFIG_LV_DISABLE_ASSERT_HANDLER_INCLUDE_WARNING=y

# KORVO V1.3 - Bluetooth Classic HFP Audio Gateway (ESP32-S31)
CONFIG_BT_ENABLED=y
# CONFIG_BT_BLE_ENABLED is not set
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1
CONFIG_BT_CTRL_BR_EDR_MAX_SYNC_CONN=1
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HFP_ENABLE=y
# CONFIG_BT_HFP_CLIENT_ENABLE is not set
CONFIG_BT_HFP_AG_ENABLE=y
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
# CONFIG_BT_HFP_USE_EXTERNAL_CODEC is not set
# CONFIG_BT_HFP_WBS_ENABLE is not set

# ESP-IDF 6.1 + GCC 15.x build compatibility
# Bluedroid currently emits -Wstringop-truncation in IDF source; keep the
# framework-provided compatibility switch enabled so that this default warning
# does not abort the application build.
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# V1.3.17: allow selected task stacks (face AI) in PSRAM
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
